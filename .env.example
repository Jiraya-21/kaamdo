# ==============================================================================
# KaamDo Environment Configuration Template
# Copy this file to '.env' and adjust values for your local or production setup.
# DO NOT put real secrets, production passwords, or provider keys in this file.
# ==============================================================================

# Security
# Local development may keep DEBUG=True. A public site must use DEBUG=False
# and a unique SECRET_KEY of at least 50 characters. Placeholder secrets and
# django-insecure-* keys are refused when DEBUG is off.
DEBUG=True
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Staging and production need PostgreSQL. SQLite is local-only.
# KAAMDO_ALLOW_SQLITE=true is an emergency local escape hatch only.
# KAAMDO_ALLOW_SQLITE=false

# Optional map provider. Default none. Do not set nominatim autocomplete.
# KAAMDO_MAP_PROVIDER=none
# KAAMDO_MAP_ATTRIBUTION=Map data © OpenStreetMap contributors

# Hosts such as Render set PORT. Django runserver ignores it.
# A process manager must bind 0.0.0.0:%PORT%. See docs/DEPLOYMENT_GUIDE.md.
# PORT=8000
# STATIC_URL=static/
# STATIC_ROOT=
# MEDIA_ROOT=

# Official Karnataka districts/taluks are in code. After an isolated migrate:
#   python manage.py seed_karnataka_locations
# Do not invent villages or coordinates.

# When DEBUG=False, set these to the real public hostname and frontend origin.
# Do not use *. HTTPS redirect is not enabled in application settings; turn it
# on at the reverse proxy only after the certificate is in place.
# CSRF_TRUSTED_ORIGINS=https://your-frontend-origin.example
# CORS_ALLOWED_ORIGINS=https://your-frontend-origin.example
# Set this only after a reverse proxy you control overwrites X-Forwarded-Proto.
# KAAMDO_TRUST_X_FORWARDED_PROTO=false

# Database Configuration
# Leave DB_ENGINE=sqlite for the current local app. SQLite ignores DB_NAME,
# DB_USER, DB_HOST, and DB_PORT so those values cannot retarget backend/db.sqlite3.
# Do not point tests at backend/db.sqlite3. Django tests use a temporary database.
# Do not run migrate against the existing local file unless you intend to.
DB_ENGINE=sqlite
DB_NAME=kaamdo_db
DB_USER=kaamdo_user
DB_PASSWORD=your_secure_password_here
DB_HOST=127.0.0.1
DB_PORT=5432
#
# Optional Docker PostgreSQL (see docs/DOCKER_SETUP.md). Copy this file to `.env`
# (already gitignored). Keep DB_ENGINE=sqlite until you want Django to use Postgres.
# POSTGRES_DB=kaamdo_staging
# POSTGRES_USER=kaamdo
# POSTGRES_PASSWORD=kaamdo_dev_only_change_me
# POSTGRES_PORT=5433
# Then install the driver and point Django at the container only:
#   python -m pip install "psycopg[binary]"
# DB_ENGINE=postgresql
# DB_NAME=kaamdo_staging
# DB_USER=kaamdo
# DB_PASSWORD=kaamdo_dev_only_change_me
# DB_HOST=127.0.0.1
# DB_PORT=5433
# Do not set DB_NAME to backend/db.sqlite3. Do not enable DEBUG=False here
# unless SECRET_KEY, ALLOWED_HOSTS, and CORS are set for a host you control.

# CORS Configuration (Allowed Frontend Origins)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8768,http://127.0.0.1:8768

# Geo / Search Configuration
DEFAULT_SEARCH_RADIUS_KM=20

# OTP / SMS / email
# Keep unconfigured until you approve a live SMS test. Development codes appear
# only when DEBUG=True and KAAMDO_OTP_DELIVERY=development. They are not SMS.
KAAMDO_OTP_DELIVERY=unconfigured
# Put the SMSMobileAPI key only in the server .env, never in source or the browser.
# Leave the next line commented until you approve a live test:
# SMSMOBILEAPI_API_KEY=
# Then set KAAMDO_OTP_DELIVERY=smsmobileapi on the server and restart the API.
# SMSMOBILEAPI_TIMEOUT_SECONDS=10
#
# Per-IP OTP limits (in addition to 3 sends per phone+purpose / 15 minutes).
# Defaults: 8 sends and 25 verifies per IP per 15 minutes.
# KAAMDO_OTP_IP_SEND_LIMIT=8
# KAAMDO_OTP_IP_VERIFY_LIMIT=25
# KAAMDO_OTP_IP_WINDOW_MINUTES=15
# X-Forwarded-For is ignored unless the connecting address is listed here.
# Set this to the reverse-proxy addresses that terminate TLS, never to *.
# Example: KAAMDO_OTP_TRUSTED_PROXIES=10.0.0.1,10.0.0.2
# KAAMDO_OTP_TRUSTED_PROXIES=
#
# Shared OTP IP limits. Default locmem is per-process and needs no extra package.
# KAAMDO_CACHE_BACKEND=locmem
# For more than one gunicorn/uwsgi worker, install redis and point at Redis:
#   python -m pip install "redis>=5,<7"
# KAAMDO_CACHE_BACKEND=redis
# KAAMDO_CACHE_URL=redis://127.0.0.1:6379/1

# Media (worker profile photos)
# Local DEBUG serves files from backend/media at /media/. Production must point
# the reverse proxy or object storage at MEDIA_ROOT and keep MEDIA_URL=/media/.
# Published photos are public. Do not store identity documents in this folder.
# MEDIA_ROOT is backend/media when unset. Do not put secrets in uploaded files.

# Payments
# Keep unconfigured. A public site must leave this unconfigured.
# Local physical testing only, with DEBUG=True and a staff account:
#   KAAMDO_VISIT_PAYMENT=test_bypass
# (mock_demo is the same skip.) The record is mock_recorded, not gateway_verified.
# No money is collected. DEBUG=False or a non-staff token cannot enable this.
# Do not set this in a public deployment.
KAAMDO_VISIT_PAYMENT=unconfigured

# Daily Services matching (straight-line km, not road distance).
# Automatic expiry and the next batch run only when this command is scheduled:
#   python manage.py process_daily_matching
# Local loop (supervised): python manage.py run_matching_loop --interval 15
# KAAMDO_MATCH_BATCH_SIZE=3
# KAAMDO_MATCH_OFFER_WINDOW_SECONDS=180
# KAAMDO_MATCH_MAX_ROUNDS=6
# KAAMDO_MATCH_RADIUS_STAGES=8,15,20
# KAAMDO_MATCH_MAX_RADIUS_KM=50

# Unused placeholders. The app does not send SMS from these values today.
# SMS_GATEWAY_API_KEY=
# SMS_SENDER_ID=
